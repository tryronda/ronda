{
  "name": "ronda-desktop",
  "private": true,
  "version": "0.0.1",
  "description": "A local desktop library for coding-agent sessions.",
  "license": "AGPL-3.0-only",
  "homepage": "https://tryronda.cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tryronda/ronda.git"
  },
  "bugs": "https://github.com/tryronda/ronda/issues",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "check": "vitest run && tsc --noEmit",
    "site:dev": "vite --config vite.site.config.ts",
    "site:build": "bun scripts/prerender-site.ts",
    "site:preview": "vite preview --config vite.site.config.ts",
    "site:brand-assets": "bun scripts/render-brand-assets.ts",
    "prepare:sidecars": "bun scripts/prepare-sidecars.mjs",
    "prepare:sidecars:release": "bun scripts/prepare-sidecars.mjs --release",
    "tauri:dev": "bun run prepare:sidecars && tauri dev",
    "tauri:build": "bun run prepare:sidecars:release && tauri build"
  },
  "dependencies": {
    "@fontsource-variable/afacad": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "motion": "^13.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "happy-dom": "20.14.0",
    "tailwindcss": "^4",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
