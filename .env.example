# Google Analytics for the marketing site only. The desktop app sends nothing.
#
# The measurement id for tryronda.cloud is the default in vite.site.config.ts, so a deploy needs
# nothing set here. The measurement id is public: it ships in the markup of every page.
#
# Set this to an empty string to build the site with no analytics tag, which is what you want for
# a local production build you are going to open yourself:
#
#   GA_MEASUREMENT_ID= bun run site:build
#
# The dev server (bun run site:dev) never injects the tag at all.
GA_MEASUREMENT_ID=
